# Jira Data Ingestion Framework — example environment file.
# Copy to .env and fill in your own values. NEVER commit .env or any
# real secret to git; .env is covered by .gitignore.

# Jira Cloud site URL, e.g. https://your-company.atlassian.net
JIRA_BASE_URL=https://your-company.atlassian.net
# Email address used for Jira basic authentication.
JIRA_EMAIL=you@company.com
# Jira API token (create one at https://id.atlassian.com/manage-profile/security/api-tokens).
JIRA_API_TOKEN=your-jira-api-token-here
# Authentication type: basic (email + API token) or bearer.
JIRA_AUTH_TYPE=basic

# Google Sheets service-account credentials (only needed when the
# google_sheets output is enabled in config/config.yaml).
GOOGLE_APPLICATION_CREDENTIALS=credentials/service_account.json
