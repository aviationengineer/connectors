# Copy to .env and fill in (never commit .env).
# Tokens are obtained via:  python scripts/linkedin_auth.py

# OAuth 2.0 bearer token for the authenticated member (required to run).
LINKEDIN_ACCESS_TOKEN=
# Refresh token, when LinkedIn issued one (approved partners only).
LINKEDIN_REFRESH_TOKEN=
# LinkedIn developer app credentials (needed for auth + refresh only).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Redirect URI registered on the LinkedIn app (must match exactly).
LINKEDIN_REDIRECT_URI=http://localhost:8080
# LinkedIn API version (monthly versions sunset after ~1 year).
LINKEDIN_API_VERSION=202610
LINKEDIN_TIMEOUT=30
ENVIRONMENT=DEV
LOG_LEVEL=INFO
